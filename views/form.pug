
doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet" href="/css/style.css")
  body
    h1 Add or Update a Book

    .form-wrapper
      form(action="/save" method="POST")
        label(for="book_name") Book Name
        input#book_name(type="text" name="book_name" required)

        label(for="author") Author
        input#author(type="text" name="author" required)

        label(for="reading_status") Reading Status
        select#reading_status(name="reading_status" required)
          option(value="") Select a status
          option(value="To Read") To Read
          option(value="Reading") Reading
          option(value="Completed") Completed

        button(type="submit") Save Book

    p
      a(href="/") Back to Books
